RULE: STX_SCOPE   (start)
-
	SEQ
		OPT
			SEQ
				TOKEN  --- TK_SCOPE
				TOKEN  --- TK_IDENTIFIER
		TOKEN  --- TK_LBRACE
		ALT
			TOKEN  --- TK_SEMICOLON
			SEQ
				ALT
					SYNTAX --- STX_CLASS
					SYNTAX --- STX_FNDEF
					SYNTAX --- STX_IF
					SYNTAX --- STX_WHILE
					SYNTAX --- STX_FOR
					SYNTAX --- STX_DECLARE
					SYNTAX --- STX_ASSIGN
					SYNTAX --- STX_INIT
					SYNTAX --- STX_ECHO
					SYNTAX --- STX_BREAK
					SYNTAX --- STX_RETURN
					SYNTAX --- STX_EXIT
				REPEAT
					ALT
						SYNTAX --- STX_CLASS
						SYNTAX --- STX_FNDEF
						SYNTAX --- STX_IF
						SYNTAX --- STX_WHILE
						SYNTAX --- STX_FOR
						SYNTAX --- STX_DECLARE
						SYNTAX --- STX_ASSIGN
						SYNTAX --- STX_INIT
						SYNTAX --- STX_ECHO
						SYNTAX --- STX_BREAK
						SYNTAX --- STX_RETURN
						SYNTAX --- STX_EXIT
		TOKEN  --- TK_RBRACE

----
----

RULE: STX_CLASS
-
	SEQ
		TOKEN  --- TK_CLASS
		TOKEN  --- TK_IDENTIFIER
		SYNTAX --- STX_SCOPE

----
----

RULE: STX_FNDEF
-
	SEQ
		TOKEN  --- TK_FN
		TOKEN  --- TK_IDENTIFIER
		TOKEN  --- TK_LPAREN
		ALT
			SYNTAX --- STX_NIL
			SEQ
				SYNTAX --- STX_VTYPE
				SYNTAX --- STX_VAR
				REPEAT
					SEQ
						TOKEN  --- TK_COMMA
						SYNTAX --- STX_VTYPE
						SYNTAX --- STX_VAR
		TOKEN  --- TK_RPAREN
		SYNTAX --- STX_RARROW
		ALT
			SYNTAX --- STX_VTYPE
			SYNTAX --- STX_NIL
		SYNTAX --- STX_SCOPE

----
----

RULE: STX_IF
-
	SEQ
		TOKEN  --- TK_IF
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_RPAREN
		SYNTAX --- STX_SCOPE
		REPEAT
			SEQ
				TOKEN  --- TK_ELSE
				TOKEN  --- TK_IF
				TOKEN  --- TK_LPAREN
				SYNTAX --- STX_EXPR
				TOKEN  --- TK_RPAREN
				SYNTAX --- STX_SCOPE
		OPT
			SEQ
				TOKEN  --- TK_ELSE
				SYNTAX --- STX_SCOPE

----
----

RULE: STX_WHILE
-
	SEQ
		TOKEN  --- TK_WHILE
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_RPAREN
		SYNTAX --- STX_SCOPE

----
----

RULE: STX_FOR
-
	SEQ
		TOKEN  --- TK_FOR
		TOKEN  --- TK_LPAREN
		ALT
			SYNTAX --- STX_ASSIGN
			SYNTAX --- STX_INIT
		ALT
			SYNTAX --- STX_GEXPR
			SYNTAX --- STX_EXPR
		TOKEN  --- TK_SEMICOLON
		ALT
			SYNTAX --- STX_INCREMENT
			SYNTAX --- STX_DECREMENT
		TOKEN  --- TK_RPAREN
		ALT
			TOKEN  --- TK_SEMICOLON
			SYNTAX --- STX_SCOPE

----
----

RULE: STX_FORRANGE
-
	SEQ
		TOKEN  --- TK_FOR
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_VAR
		TOKEN  --- TK_IN
		ALT
			SYNTAX --- STX_MEMBER
			SYNTAX --- STX_FNCALL
			SYNTAX --- STX_VAR
		TOKEN  --- TK_RPAREN
		ALT
			TOKEN  --- TK_SEMICOLON
			SYNTAX --- STX_SCOPE

----
----

RULE: STX_SWITCH
-
	SEQ
		TOKEN  --- TK_SWITCH
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_RPAREN
		TOKEN  --- TK_LBRACE
		SYNTAX --- STX_CASE
		REPEAT
			SYNTAX --- STX_CASE
		TOKEN  --- TK_RBRACE

----
----

RULE: STX_CASE
-
	SEQ
		TOKEN  --- TK_CASE
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_COLON
		SYNTAX --- STX_SCOPE

----
----

RULE: STX_INIT
-
	SEQ
		SYNTAX --- STX_VTYPE
		SYNTAX --- STX_VAR
		SYNTAX --- STX_EQUAL
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_DECLARE
-
	SEQ
		SYNTAX --- STX_VTYPE
		SYNTAX --- STX_VAR
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_ASSIGN
-
	SEQ
		ALT
			SYNTAX --- STX_MEMBER
			SYNTAX --- STX_VAR
		SYNTAX --- STX_ASSIGNOP
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_ECHO
-
	SEQ
		ALT
			SYNTAX --- STX_INCREMENT
			SYNTAX --- STX_DECREMENT
			SYNTAX --- STX_MEMBER
			SYNTAX --- STX_FNCALL
			SYNTAX --- STX_EXPR
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_BREAK
-
	SEQ
		TOKEN  --- TK_BREAK
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_RETURN
-
	SEQ
		TOKEN  --- TK_RETURN
		OPT
			ALT
				SYNTAX --- STX_EXPR
				SYNTAX --- STX_MEMBER
				SYNTAX --- STX_FNCALL
				SYNTAX --- STX_INDEX
				SYNTAX --- STX_VAR
				SYNTAX --- STX_NUM
				SYNTAX --- STX_STRLIT
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_EXIT
-
	SEQ
		TOKEN  --- TK_EXIT
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_RPAREN
		TOKEN  --- TK_SEMICOLON

----
----

RULE: STX_GEXPR
-
	SEQ
		TOKEN  --- TK_LPAREN
		SYNTAX --- STX_EXPR
		TOKEN  --- TK_RPAREN

----
----

RULE: STX_EXPR
-
	SEQ
		OPT
			ALT
				SYNTAX --- STX_NOT
				SYNTAX --- STX_NEGATE
		ALT
			SYNTAX --- STX_GEXPR
			SYNTAX --- STX_MEMBER
			SYNTAX --- STX_INDEX
			SYNTAX --- STX_FNCALL
			SYNTAX --- STX_VAR
			SYNTAX --- STX_NUM
			SYNTAX --- STX_STRLIT
			SYNTAX --- STX_TRUE
			SYNTAX --- STX_FALSE
		REPEAT
			SEQ
				ALT
					SYNTAX --- STX_ARITHOP
					SYNTAX --- STX_BOOLOP
				OPT
					ALT
						SYNTAX --- STX_NOT
						SYNTAX --- STX_NEGATE
				ALT
					SYNTAX --- STX_GEXPR
					SYNTAX --- STX_MEMBER
					SYNTAX --- STX_INDEX
					SYNTAX --- STX_FNCALL
					SYNTAX --- STX_VAR
					SYNTAX --- STX_NUM
					SYNTAX --- STX_STRLIT
					SYNTAX --- STX_TRUE
					SYNTAX --- STX_FALSE

----
----

RULE: STX_VTYPE
-
	SEQ
		OPT
			TOKEN  --- TK_CONST
		ALT
			TOKEN  --- TK_BOOL
			TOKEN  --- TK_FLT
			TOKEN  --- TK_I64
			TOKEN  --- TK_I32
			TOKEN  --- TK_I16
			TOKEN  --- TK_I8
			TOKEN  --- TK_U64
			TOKEN  --- TK_U32
			TOKEN  --- TK_U16
			TOKEN  --- TK_U8
			TOKEN  --- TK_STR
			TOKEN  --- TK_IDENTIFIER
		OPT
			SEQ
				TOKEN  --- TK_LSQUARE
				TOKEN  --- TK_RSQUARE

----
----

RULE: STX_VAR
-
	TOKEN  --- TK_IDENTIFIER

----
----

RULE: STX_MEMBER
-
	SEQ
		ALT
			SYNTAX --- STX_THIS
			SYNTAX --- STX_INDEX
			TOKEN  --- TK_IDENTIFIER
		TOKEN  --- TK_DOT
		ALT
			SYNTAX --- STX_INDEX
			TOKEN  --- TK_IDENTIFIER
		REPEAT
			SEQ
				TOKEN  --- TK_DOT
				ALT
					SYNTAX --- STX_INDEX
					TOKEN  --- TK_IDENTIFIER

----
----

RULE: STX_THIS
-
	TOKEN  --- TK_THIS

----
----

RULE: STX_INDEX
-
	SEQ
		SYNTAX --- STX_VAR
		TOKEN  --- TK_LSQUARE
		ALT
			SYNTAX --- STX_GEXPR
			SYNTAX --- STX_EXPR
		TOKEN  --- TK_RSQUARE
		REPEAT
			SEQ
				TOKEN  --- TK_LSQUARE
				ALT
					SYNTAX --- STX_GEXPR
					SYNTAX --- STX_EXPR
				TOKEN  --- TK_RSQUARE

----
----

RULE: STX_FNCALL
-
	SEQ
		ALT
			SYNTAX --- STX_MEMBER
			TOKEN  --- TK_IDENTIFIER
		TOKEN  --- TK_LPAREN
		OPT
			ALT
				SYNTAX --- STX_EXPR
				SYNTAX --- STX_NIL
		REPEAT
			SEQ
				TOKEN  --- TK_COMMA
				ALT
					SYNTAX --- STX_EXPR
					SYNTAX --- STX_NIL
		TOKEN  --- TK_RPAREN

----
----

RULE: STX_NUM
-
	TOKEN  --- TK_NUM

----
----

RULE: STX_STRLIT
-
	TOKEN  --- TK_CHARS

----
----

RULE: STX_NIL
-
	TOKEN  --- TK_NIL

----
----

RULE: STX_ARITHOP
-
	ALT
		SYNTAX --- STX_MULT
		SYNTAX --- STX_DIV
		SYNTAX --- STX_SUM
		SYNTAX --- STX_DIFF
		SYNTAX --- STX_MOD

----
----

RULE: STX_BOOLOP
-
	ALT
		SYNTAX --- STX_GREATER
		SYNTAX --- STX_LESS
		SYNTAX --- STX_NOT_EQUAL
		SYNTAX --- STX_EQUAL_EQUAL
		SYNTAX --- STX_GREATER_EQUAL
		SYNTAX --- STX_LESS_EQUAL
		SYNTAX --- STX_AND
		SYNTAX --- STX_OR

----
----

RULE: STX_ASSIGNOP
-
	ALT
		SYNTAX --- STX_EQUAL
		SYNTAX --- STX_PLUS_EQUAL
		SYNTAX --- STX_MINUS_EQUAL
		SYNTAX --- STX_STAR_EQUAL
		SYNTAX --- STX_DIV_EQUAL

----
----

